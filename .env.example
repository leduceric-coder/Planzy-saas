# Planzy SaaS — Variables d'environnement
# Copier en .env.local pour le dev local
# Toutes les valeurs ci-dessous sont des placeholders — ne JAMAIS commiter de vraies clés.

# ── Supabase (projet dédié planzy-saas) ──────────────────────
# Récupérer sur https://supabase.com/dashboard/project/<ref>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
# Service role : NE JAMAIS exposer côté client. Stockage Vercel = "Sensitive".
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret>

# ── URL publique de l'app ────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Stripe (optionnel) ───────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_<your-secret>
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_<your-publishable>

# ── Feux France (mini-app carto /feux) ───────────────────────
# Clé NASA FIRMS — STRICTEMENT côté serveur, jamais exposée au navigateur.
# Obtenir gratuitement une MAP_KEY : https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Si absente, l'app bascule automatiquement en « Mode démonstration ».
FIRMS_MAP_KEY=
# Nom public de l'application (affiché dans la barre supérieure).
NEXT_PUBLIC_APP_NAME=Feux France
